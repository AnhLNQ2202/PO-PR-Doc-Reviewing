# Cổng HTTP trên vServer. Khi có GreenNode vLB, cho vLB chuyển tiếp tới cổng này.
APP_HTTP_PORT=8080

# GreenNode MaaS (API tương thích OpenAI).
# Dán endpoint chính xác được cấp trong Playground/tài khoản tài trợ.
# Không đặt dấu nháy quanh giá trị; ưu tiên URL https://.../v1.
MAAS_BASE_URL=
# Chỉ đổi thành true nếu GreenNode cấp endpoint HTTP và bạn hiểu dữ liệu/key
# sẽ không được mã hóa trên đường truyền. Giữ false khi dùng HTTPS.
ALLOW_INSECURE_MAAS_HTTP=false
MAAS_API_KEY=
MAAS_MODEL=GreenNode/GreenMind-Medium-14B-R1

# Đây là kích thước từng miếng gửi cho model, không phải giới hạn file/PDF.
MAAS_TIMEOUT_SECONDS=240
MAAS_MAX_OUTPUT_TOKENS=8000
MAAS_CHUNK_CHARS=16000
MAAS_MERGE_CHARS=60000

# GreenNode chưa cam kết hỗ trợ json_schema trên mọi model.
# Dùng none an toàn nhất; chỉ đổi thành json_object sau khi đã thử model.
MAAS_JSON_MODE=none

# OCR tiếng Việt và tiếng Anh.
OCR_LANG=vie+eng
LOG_LEVEL=INFO
APP_VERSION=dev
